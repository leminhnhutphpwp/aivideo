# Daemon configuration
PORT=7456
BIND_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ──────────────────────────────────────────
# QwenCloud (Alibaba) — Video + Image
# ──────────────────────────────────────────
# Video: wan2.6/2.7 t2v, i2v, r2v, videoedit, animate, happyhorse
# Image: qwen-image-2.0-pro, qwen-image-edit, wan2.7-image-pro
# Register: https://www.alibabacloud.com/en/product/dashscope
DASHSCOPE_API_KEY=sk-your-qwencloud-key

# ──────────────────────────────────────────
# CKey (OpenAI-compatible) — TTS + Image
# ──────────────────────────────────────────
# TTS: tts-1, giọng Việt Bắc/Nam
# Image: gpt-image-2
# Register: https://ckey.vn
CKEY_API_KEY=sk-your-ckey-key
# TTS_PROVIDER=ckey

# ──────────────────────────────────────────
# Cloudflare Workers AI — Image generation
# ──────────────────────────────────────────
# Model: @cf/bytedance/stable-diffusion-xl-lightning (T2I) + @cf/runwayml/stable-diffusion-v1-5-img2img (I2I)
# API: https://image-generation.minhnhut1999nb.workers.dev
CLOUDFLARE_API_KEY=your-cloudflare-worker-api-key

# ──────────────────────────────────────────
# Chat / LLM — auto-voiceover script generation
# ──────────────────────────────────────────
# LLM_API_KEY=sk-your-llm-key

# ──────────────────────────────────────────
# S3 / Object Storage — store generated files in S3-compatible storage
# ──────────────────────────────────────────
# S3_ENABLED=0
# S3_REGION=auto
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=daemon
# S3_PUBLIC_URL=

# ──────────────────────────────────────────
# Webhook & Auth
# ──────────────────────────────────────────
WEBHOOK_SECRET=change-me-to-a-random-string
# DAEMON_AUTH_ENABLED=0
# DAEMON_AUTH_REQUIRED=0
# DAEMON_METRICS_TOKEN=

# ──────────────────────────────────────────
# Dev
# ──────────────────────────────────────────
MEDIA_ALLOW_STUBS=1
SKILLS_DIR=/skills
# PROJECT_ROOT=/app
# DATA_DIR=/app/.od
# SHUTDOWN_GRACE_MS=300000

# ──────────────────────────────────────────
# Simulation Mode — override real API with fake files (debug/testing)
# ──────────────────────────────────────────
# SIMULATION_MODE=1
# SIMULATION_LATENCY_IMAGE=3000       # ms base delay for image generation
# SIMULATION_LATENCY_VIDEO=20000     # ms base delay for video generation
# SIMULATION_LATENCY_AUDIO=2000      # ms base delay for audio generation
# SIMULATION_LATENCY_JITTER=0.3      # random ±30% jitter multiplier
