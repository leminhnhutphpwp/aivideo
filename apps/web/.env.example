# ──────────────────────────────────────────
# Next.js — Frontend Environment
# Copy to .env.local for local dev
# ──────────────────────────────────────────

# Laravel Backend API URL
NEXT_PUBLIC_LARAVEL_URL=http://localhost:8000

# Site URL for SEO (sitemap, robots, OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reverb WebSocket (real-time notifications)
NEXT_PUBLIC_REVERB_APP_KEY=odnzwdnc8shuoqelgdlu
NEXT_PUBLIC_REVERB_HOST=localhost:8080
NEXT_PUBLIC_REVERB_SCHEME=http

# ──────────────────────────────────────────
# Maintenance mode (server-side, runtime — restart web to apply, no rebuild)
# Accepts: true / 1 / on  → bật bảo trì.  Mặc định tắt.
# ──────────────────────────────────────────

# Bảo trì khu vực ứng dụng đã đăng nhập (dashboard, studio, projects, billing…)
MAINTENANCE_DASHBOARD=false

# Bảo trì trang chủ công khai ("/")
MAINTENANCE_LANDING=false

# ──────────────────────────────────────────
# Coupon / Event security hardening (BFF + Turnstile)
# ──────────────────────────────────────────

# HMAC secret dùng để ký request BFF → Laravel (Layer 4).
# ⚠️ SERVER-ONLY — KHÔNG có tiền tố NEXT_PUBLIC (không được lộ ra browser).
# Route handlers đọc qua process.env. PHẢI trùng đúng APP_BFF_SECRET của Laravel.
# Để TRỐNG = tắt ký (dev fail-open — Laravel cũng bỏ qua). KHÔNG commit secret thật.
APP_BFF_SECRET=

# URL Laravel mà Next.js server (route handlers) gọi tới — KHÁC với browser.
# Trong Docker web container gọi Laravel qua service `app`, nên đặt:
#   LARAVEL_INTERNAL_URL=http://app:8000
# Nếu chạy web trực tiếp trên host thì có thể để trống (fallback về localhost:8000).
LARAVEL_INTERNAL_URL=http://app:8000

# Cloudflare Turnstile — site key công khai (Layer 3, human verification).
# Để TRỐNG = widget bị tắt hoàn toàn (dev fail-open — backend cũng bỏ qua).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
