# Dev image for the Next.js web app — source is bind-mounted at runtime; runs `next dev`.
# Matches the prod base (node:22-alpine). node_modules is a named volume in compose,
# seeded from the layer installed here on first run.
FROM node:22-alpine

WORKDIR /app

# Install deps first for layer caching. The bind mount overlays the source at runtime;
# the named node_modules volume is populated from this install on first container start.
COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 3000

# -H 0.0.0.0 so the dev server is reachable from the host via the published port.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
