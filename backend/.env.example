# ──────────────────────────────────────────
# Laravel Backend — Environment Config Template
# Copy to .env and fill in your secrets
# For Docker dev: use .env.docker instead
# ──────────────────────────────────────────

APP_NAME="AI Video Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aivideo_dev
DB_USERNAME=app
DB_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3

# ──────────────────────────────────────────
# Reverb (WebSocket)
# ──────────────────────────────────────────
REVERB_APP_ID=515932
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ──────────────────────────────────────────
# JWT Auth
# ──────────────────────────────────────────
JWT_SECRET=change-me

# ──────────────────────────────────────────
# Simulation Mode — use stubs instead of real API calls
# ──────────────────────────────────────────
SIMULATION_MODE=false

# ──────────────────────────────────────────
# LLM / AI Prompt Compiler
# ──────────────────────────────────────────
# Used by AiPromptCompiler to compile storyboard prompts
# CKEY_API_KEY can be shared with daemon
CKEY_API_KEY=
LLM_BASE_URL=https://ckey.vn
LLM_MODEL=gpt-4o-mini

# ──────────────────────────────────────────
# Horizon (Queue Dashboard)
# ──────────────────────────────────────────
HORIZON_ADMIN_EMAIL=admin@example.com

# ──────────────────────────────────────────
# Daemon (Media Engine) — internal, port 7456
# ──────────────────────────────────────────
DAEMON_URL=http://localhost:7456
DAEMON_CALLBACK_URL=http://localhost:8000/api/daemon/webhook
DAEMON_WEBHOOK_SECRET=change-me
DAEMON_TIMEOUT=30
DAEMON_PROJECT_ID=aivideo-platform
DAEMON_MAX_PROJECTS_PER_USER=50
DAEMON_DEFAULT_MODEL=seedance

# ──────────────────────────────────────────
# Credit Calculation — per-resolution pricing
# ──────────────────────────────────────────
CREDIT_720P_PER_SEC=1000
CREDIT_720P_MIN=5000
CREDIT_1080P_PER_SEC=2000
CREDIT_1080P_MIN=10000
CREDIT_4K_PER_SEC=4000
CREDIT_4K_MIN=20000
CREDIT_IMAGE=2000          # T2I flat fee
CREDIT_IMAGE_EDIT=3000     # I2I flat fee
VOICE_OVER_SURCHARGE=3000

# ──────────────────────────────────────────
# S3 / MinIO Storage (Primary)
# ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=aivideo-dev
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ──────────────────────────────────────────
# S3 External / R2 (Production / External Storage)
# ──────────────────────────────────────────
# S3_EXTERNAL_ACCESS_KEY_ID=
# S3_EXTERNAL_SECRET_ACCESS_KEY=
# S3_EXTERNAL_REGION=ap-southeast-1
# S3_EXTERNAL_BUCKET=
# S3_EXTERNAL_URL=
# S3_EXTERNAL_ENDPOINT=
# S3_EXTERNAL_USE_PATH_STYLE_ENDPOINT=false

# ──────────────────────────────────────────
# Payment — SePay
# ──────────────────────────────────────────
SEPAY_WEBHOOK_TOKEN=
SEPAY_BANK=MB Bank
SEPAY_ACCOUNT=0359123456
SEPAY_HOLDER=
SEPAY_MATCH_PATTERN=SE

# ──────────────────────────────────────────
# Security
# ──────────────────────────────────────────
FORCE_HTTPS=false

# ──────────────────────────────────────────
# Telegram Bot
# ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ──────────────────────────────────────────
# Google OAuth
# ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ──────────────────────────────────────────
# Email
# ──────────────────────────────────────────
MAIL_MAILER=log

# ──────────────────────────────────────────
# Coupon / Event Security (4-layer hardening)
# ──────────────────────────────────────────
# Layer 4 — HMAC: secret chia sẻ giữa Next BFF và Laravel. PHẢI trùng với BFF.
# Để trống = TẮT kiểm tra chữ ký (dev fail-open).
APP_BFF_SECRET=
# Độ lệch thời gian tối đa cho X-BFF-Timestamp (giây).
APP_BFF_MAX_SKEW=300
# Layer 3 — Cloudflare Turnstile secret key. Để trống = TẮT (dev fail-open).
TURNSTILE_SECRET=
# Layer 2 — Velocity / anti-farm.
# Tuổi tài khoản tối thiểu (phút) mới được dùng mã. 0 = tắt. Prod nên đặt ~15.
COUPON_MIN_ACCOUNT_AGE_MINUTES=0
# Bắt buộc xác thực email trước khi dùng mã.
COUPON_REQUIRE_VERIFIED=true
# Giới hạn số lượt dùng mã theo IP mỗi ngày. 0 = tắt. Prod nên đặt ~20.
COUPON_PER_IP_DAILY_CAP=0
